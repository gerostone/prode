# =================================================================
# Variables de entorno — Prode 2026
# Copiar este archivo como .env.local y completar con tus valores.
# NUNCA commitear .env.local al repositorio.
# =================================================================

# --- Supabase ---
# Encontralo en: dashboard.supabase.com → tu proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Solo en servidor (cron jobs, edge functions). NO empezar con NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Football-Data.org ---
# Plan free, 10 req/min: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cron jobs ---
# Random string 32+ caracteres. Generar con: openssl rand -hex 32
# Setear el MISMO valor en Vercel (Project Settings → Environment Variables)
CRON_SECRET=
